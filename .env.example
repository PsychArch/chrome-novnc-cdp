TZ=UTC

# Browser display shown through noVNC.
BROWSER_WIDTH=1920
BROWSER_HEIGHT=1080
BROWSER_DEPTH=24
BROWSER_START_URL=about:blank
BROWSER_EXTRA_ARGS=

# Set true when Chromium needs http://host.docker.internal:PORT in bridge networking.
ENABLE_HOST_GATEWAY=false

# Public URL prefix for CDP/session links when reverse-proxying under a path.
# Leave empty for root paths, or set to /cdp for https://example.com/cdp/...
PUBLIC_CDP_BASE_PATH=

# Managed CDP sessions.
MAX_SESSIONS=4
SESSION_IDLE_TIMEOUT=1h
SESSION_SWEEP_INTERVAL=15s

# CDP/API access. Leave empty for localhost-only personal use.
CDP_AUTH_TOKEN=
CDP_COMPAT_AUTO_SESSION=true
CDP_ALLOW_UNAUTHENTICATED_LOCAL=false
CDP_ALLOW_QUERY_TOKEN=false

NOVNC_VERSION=1.6.0
NOVNC_SHA256=5066103959ef4e9b10f37e5a148627360dd8414e4cf8a7db92bdbd022e728aaa
WEBSOCKIFY_VERSION=0.13.0
WEBSOCKIFY_SHA256=b6413e364efd04f3c92ec8c17747e3c4adc20157c2ef1c5d019a26d944a46df8
